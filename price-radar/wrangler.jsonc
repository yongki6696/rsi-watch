{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 앱 이름(주소에도 쓰임): https://price-radar.<계정>.workers.dev
  "name": "price-radar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // 데이터베이스는 처음 배포할 때 자동으로 만들어져요 (database_id 를 적지 않아도 됨)
  "d1_databases": [{ "binding": "DB", "database_name": "price-radar" }],
  // 5분마다 가격 확인 작업을 깨워요 (실제 쿠팡 API 호출 수는 API_HOURLY_LIMIT 로 따로 제한)
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": {
    "APP_NAME": "최저가 레이더",
    // 쿠팡 파트너스 API 를 1시간에 최대 몇 번 부를지. 비공식 자료로는 30회를 넘기면 정지된다고 하니 넉넉히 낮게.
    "API_HOURLY_LIMIT": "20",
    // 같은 상품을 다시 확인하기까지 최소 간격(분)
    "CHECK_INTERVAL_MIN": "60",
    // 한 사람이 등록할 수 있는 알림 수
    "MAX_WATCHES_PER_USER": "30",
    // 한 번 실행에 보내는 푸시 수 (무료 플랜 CPU 10ms 한도 때문에 작게, 남은 알림은 5분 뒤에)
    "MAX_PUSH_PER_RUN": "8"
  },
  "observability": { "enabled": true }
}
